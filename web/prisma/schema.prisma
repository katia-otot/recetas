generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Preparado para uso colaborativo futuro (auth más adelante)
model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  name      String?
  createdAt DateTime @default(now())
  recipes   Recipe[]
}

model Recipe {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  rawText         String?
  extraNotes      String?
  priority        Int?
  sheetTab        String?
  sheetRow        Int?
  ingredientsJson String?
  stepsJson       String?
  cfeJson         String?
  ingredientIndex String?
  tagsJson        String?
  cuisineJson     String?
  versionsJson    String?
  structureError  String?
  status          String   @default("importado")
  createdById     String?
  createdBy       User?    @relation(fields: [createdById], references: [id])
  sources         RecipeSource[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model RecipeSource {
  id        String  @id @default(cuid())
  recipeId  String
  recipe    Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  url       String
  isPrimary Boolean @default(true)
}

model ImportBatch {
  id        String   @id @default(cuid())
  filename  String
  sheetTab  String?
  rowCount  Int
  createdAt DateTime @default(now())
}
