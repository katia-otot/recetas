# Copiar a .env.local y completar valores.
# Rutas relativas a web/ (donde corre npm run dev).

DATABASE_URL="file:../data/recetas.db"

OPENROUTER_API_KEY=
OPENROUTER_MODEL="deepseek/deepseek-v4.1-flash"
OPENROUTER_MODEL_FALLBACKS=""

# Auth.js (Google)
# Generar: node -e "console.log(require('crypto').randomBytes(33).toString('base64'))"
AUTH_SECRET=
# Credenciales OAuth de Google Cloud Console
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Local: http://localhost:3000
# Producción (con basePath /recetas): https://katiagadea.com.ar/recetas/api/auth
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Opcional pero recomendado: emails permitidos, separados por coma.
# Quien entre con un link de invitación válido puede saltar esta lista.
AUTH_ALLOWED_EMAILS=
